{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Menu Configuration",
  "type": "object",
  "required": ["id", "label", "children"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique menu root identifier"
    },
    "label": {
      "type": "string",
      "description": "Display title for the root menu"
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/menuNode"
      }
    }
  },
  "$defs": {
    "menuNode": {
      "type": "object",
      "required": ["id", "label", "type"],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["group", "action", "back"]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/menuNode"
          }
        },
        "target": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        },
        "isBackOption": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
